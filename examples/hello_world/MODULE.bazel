"A minimal Flutter application built with rules_flutter."

bazel_dep(name = "rules_flutter", version = "0.0.0")

# git_override(
#     module_name = "rules_flutter",
#     remote = "https://github.com/kevinnguyenhoang91/rules_flutter.git",
#     commit = "a0ca3dfc2cf1359cc84663af5ad4a6a6d3b0fc47",
